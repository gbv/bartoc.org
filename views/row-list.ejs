<%
if (list && list.length) {
  const inline = locals.style === "inline"
  let view = locals.view || utils.escapeXML
  let link = s => s
  if (locals.link) {
    link = (s) => {
      if (!s.match(/^https?:\/\//)) {
        return s
      }
      let html = `<a href="${s}"`
      if (!s.startsWith(config.baseUrl)) {
        html += " target=\"blank\""
      }
      html += `>${s}</a>`
      return html
    }
  }
  const items = list.map(view).map(link).map(item => `<li>${item}</li>`)
  const listClass = inline
    ? "registry-metadata-list separated-list"
    : "registry-metadata-list"
  const content = `<ul class="${listClass}">${items.join("\n")}</ul>`
%>
  <%- include('row', { content }) %>
<% } %>
