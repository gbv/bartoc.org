<% const id = item.uri?.split("/").pop() %>

<a href="<%= utils.isBartocUri(item.uri) ? `/en/node/${id}` : item.uri %>">
  <%= utils.label(item.prefLabel).value || item.uri %>
</a>
<small class="text-muted">
  <% if (id) { %> (<%= id %>)<% } %>
  <% if (item.startDate) { %> · since <%= item.startDate %><% } %>
  <% if (item.extent) { %> · <%= item.extent %><% } %>
</small>
